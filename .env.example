# Copia este archivo a `.env` / `.env.local` y rellena los valores.
# Nunca commitees `.env`, `.pem` ni secretos reales.
# Ver: specs/057-github-app-sync/github-app-setup.md

# --- Frontend (Vite) ---
# URL base pública del BFF (sin barra final). Solo variables VITE_* llegan al bundle.
# Por defecto el cliente usa `/api` (mismo origen). NO pongas https://hito.autos sin /api:
# eso hace que /github/connect apunte a la SPA y el OAuth no arranque en el servidor.
#
# Producción (mismo dominio que la SPA + funciones Vercel):
# VITE_GITHUB_BFF_URL=https://hito.autos/api
#
# BFF en otro host:
# VITE_GITHUB_BFF_URL=https://api.tu-dominio.com
#
# Local sin valor → /api
VITE_GITHUB_BFF_URL=

# --- Backend / BFF (GitHub App) — solo en el servidor (Vercel env), NUNCA VITE_ ---
# Mínimo para OAuth (connect + callback):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Necesario para listar repos / projects (installation token):
GITHUB_APP_ID=

# Slug público de la App (github.com/apps/<slug>). Requerido para que
# "Conectar con GitHub" abra la instalación si la cuenta aún no la tiene.
# Ejemplo: si la URL es https://github.com/apps/hito-local-sync → hito-local-sync
GITHUB_APP_SLUG=

# Private key completa del .pem (incluye BEGIN/END).
# Preferible en Vercel: una sola línea con \n escapados, o base64.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_PRIVATE_KEY_BASE64=
GITHUB_PRIVATE_KEY=

# Opcional: secreto dedicado para firmar state/connectionId (si falta, se usa CLIENT_SECRET).
# GITHUB_STATE_SECRET=

# URLs exactas de la GitHub App (deben coincidir con la config en github.com).
# Si las omites, se derivan de VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
GITHUB_CALLBACK_URL=https://hito.autos/api/github/callback
GITHUB_SETUP_URL=https://hito.autos/github/connect

# Diagnóstico: GET https://hito.autos/api/github/health
